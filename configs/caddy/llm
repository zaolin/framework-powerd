# LLM endpoint: llama-server behind Caddy.
#
# The JSON access log written here is the data source for the framework-powerd
# LLM request accounting (see docs/llm.md).
#
# Port layout
# -----------
# The listen port and the upstream port MUST differ. The upstream is the host
# side of the container's published port; the container keeps listening on its
# own port internally, so only the host mapping changes.
#
#   container listens      18080
#   docker publishes       127.0.0.1:18081  ->  container 18080
#   caddy, this site       :18080           ->  127.0.0.1:18081
#
# Two mistakes to avoid here:
#
#   * Pointing this site at its own listen port creates a proxy loop.
#   * Making Caddy bind a port that is already taken aborts the whole config
#     load, so every site on this host goes down, not just this one.
#
# Deploy to /etc/caddy/conf.d/llm and reload:
#
#   sudo install -m644 llm /etc/caddy/conf.d/llm
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# `caddy validate` may log "HTTP request failed ... validation complete" for
# the health check. That is validation-mode noise, not a configuration error.
#
# The daemon reads /var/log/caddy/llm-access.log and must run as root, because
# /var/log/caddy is only readable by root and the caddy user.
#
# Overridable via the environment: LLM_PORT, LLM_UPSTREAM, LLM_LOG.
:{$LLM_PORT:18080} {
	log {
		output file {$LLM_LOG:/var/log/caddy/llm-access.log} {
			roll_size 10mb
			roll_keep 14
		}
		# Delete the headers that carry credentials. Other headers and the
		# query string are still written to the log.
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
		}
	}

	reverse_proxy {$LLM_UPSTREAM:127.0.0.1:18081} {
		health_uri /health
		health_interval 30s
	}
}
