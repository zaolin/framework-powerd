{
  "server": {
    "address": "localhost",
    "port": 8080,
    "jwt_secret": "",
    "idle_timeout": "5m"
  },
  "smartd": {
    "enabled": true,
    "service_unit": "smartd.service",
    "notify_service": "notify.mobile_app_pixel_11_pro",
    "alert_retention": "168h",
    "state_file": "/var/lib/framework-powerd/alerts.json"
  },
  "nvme": {
    "enabled": true,
    "poll_interval": "15m",
    "warn_percentage_used": 80,
    "crit_percentage_used": 90,
    "warn_available_spare": 10,
    "warn_temperature_c": 70,
    "crit_temperature_c": 80,
    "warn_err_log_entries": 1,
    "crit_err_log_entries": 10,
    "max_media_errors": 0
  },
  "gpu": {
    "enabled": true,
    "poll_interval": "5s"
  },
  "metrics": {
    "persist": true,
    "state_file": "/var/lib/framework-powerd/metrics.json",
    "save_interval": "5m"
  },
  "llm": {
    "enabled": false,
    "access_log": "/var/log/caddy/llm-access.log",
    "ignore_local_ip": true,
    "exclude_ips": [],
    "groups": [
      {"name": "home", "cidrs": ["192.168.0.0/16"]},
      {"name": "vpn", "cidrs": ["10.8.0.0/24"]}
    ],
    "counted_paths": [
      "/v1/chat/completions",
      "/chat/completions",
      "/v1/completions",
      "/completions",
      "/v1/responses",
      "/v1/messages",
      "/v1/embeddings",
      "/embedding"
    ],
    "history_days": 30,
    "state_file": "/var/lib/framework-powerd/llm.json",
    "save_interval": "1m"
  },
  "pricing": {
    "energy_price_per_kwh": 0.30,
    "currency": "EUR"
  },
  "peripherals": {
    "vrm_loss_percent": 7,
    "fan_idle_rpm": 2000
  }
}
