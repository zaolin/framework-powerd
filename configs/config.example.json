{
  "server": {
    "address": "localhost",
    "port": 8080,
    "idle_timeout": "5m"
  },
  "smartd": {
    "enabled": true,
    "service_unit": "smartd.service",
    "notify_service": "notify.mobile_app_pixel_11_pro",
    "alert_retention": "30s"
  },
  "gpu": {
    "enabled": true,
    "poll_interval": "5s"
  },
  "metrics": {
    "persist": true,
    "state_file": "/var/lib/framework-powerd/metrics.json",
    "save_interval": "5m"
  },
  "peripherals": {
    "vrm_loss_percent": 7,
    "fan_idle_rpm": 2000
  }
}
