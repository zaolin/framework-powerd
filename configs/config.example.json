{
  "server": {
    "address": "localhost",
    "port": 8080,
    "idle_timeout": "5m"
  },
  "ollama": {
    "enabled": true,
    "service_unit": "ollama.service",
    "groups": [
      {"name": "lan", "cidrs": ["192.168.0.0/16", "10.0.0.0/8"]},
      {"name": "tailscale", "cidrs": ["100.64.0.0/10"]}
    ]
  },
  "smartd": {
    "enabled": true,
    "service_unit": "smartd.service",
    "notify_service": "notify.mobile_app_pixel_11_pro",
    "alert_retention": "30s"
  },
  "gpu": {
    "enabled": true,
    "poll_interval": "5s"
  },
  "pricing": {
    "energy_price_per_kwh": 0.32,
    "currency": "EUR"
  },
  "peripherals": {
    "vrm_loss_percent": 7,
    "fan_idle_rpm": 2000
  }
}
