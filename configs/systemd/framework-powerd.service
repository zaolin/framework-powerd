[Unit]
Description=Framework Power Daemon
After=network.target power-profiles-daemon.service
Wants=power-profiles-daemon.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
ExecStart=/usr/local/bin/framework-powerd serve
# Hand the fan back to the EC whenever the daemon stops, crashes, is killed by
# the watchdog, or hits the start limit. The leading "-" ignores failures so a
# missing tool can never block shutdown. These run even when fan control is
# disabled in the daemon config; remove them if another service owns the fan.
ExecStopPost=-/usr/bin/env framework_tool --autofanctrl
ExecStopPost=-/usr/bin/env framework_tool --driver cros-ec --autofanctrl
Restart=always
RestartSec=5s
WatchdogSec=30s
# Root user is required for:
# 1. Accessing /dev/input/* (Idle Detection)
# 2. Writing power tunables under /sys
# 3. Executing powerprofilesctl/ppd
User=root
# Persisted energy aggregates live in /var/lib/framework-powerd.
StateDirectory=framework-powerd
# Adjust if needed
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Optional JWT secret generated by `make install`.
EnvironmentFile=-/etc/framework-powerd/env
# Environment=JWT_SECRET=change_me_to_enable_auth

# Hardening. ProtectKernelTunables must stay off because the daemon writes
# PCIe ASPM and cpufreq tunables under /sys.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
